<!DOCTYPE html>
<html lang="en" class="select-none">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>N5 Accounting Ledger Legend - Touchscreen Classroom Edition</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sqa: {
                            dark: '#0f172a',
                            card: '#1e293b',
                            accent: '#38bdf8',
                            gold: '#fbbf24',
                            emerald: '#10b981',
                            rose: '#f43f5e',
                            purple: '#a855f7'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Touchscreen & Display Optimizations */
        * {
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }

        /* High-Contrast Touchscreen Scrollbar */
        ::-webkit-scrollbar {
            width: 16px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b82f6;
            border-radius: 8px;
            border: 3px solid #090d16;
        }

        /* Fullscreen Simulated Mode Fallback */
        body.simulated-fullscreen {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 999999 !important;
            margin: 0 !important;
            padding: 0 0 220px 0 !important;
            background-color: #0f172a !important;
            overflow-y: auto !important;
        }

        /* Generous Scroll Buffer Class */
        .bottom-scroll-buffer {
            padding-bottom: 240px !important;
        }

        /* Active touch visual feedback */
        .touch-btn:active {
            transform: scale(0.96);
            filter: brightness(1.2);
        }

        /* Glow animation for active target card */
        @keyframes subtle-glow {
            0%, 100% { box-shadow: 0 0 20px rgba(56, 189, 248, 0.3); }
            50% { box-shadow: 0 0 45px rgba(56, 189, 248, 0.65); }
        }
        .glow-active {
            animation: subtle-glow 2s infinite;
        }

        /* Overlay Confetti Canvas */
        #confettiCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 9999999;
        }
    </style>
</head>
<body class="min-h-screen bg-slate-900 text-slate-100 flex flex-col font-sans antialiased bottom-scroll-buffer">

    <!-- Confetti Overlay Canvas -->
    <canvas id="confettiCanvas"></canvas>

    <!-- MAIN APP CONTAINER -->
    <div id="appContainer" class="flex-1 flex flex-col min-h-screen p-3 sm:p-6 max-w-7xl mx-auto w-full bottom-scroll-buffer">

        <!-- HEADER & TOP CONTROLS -->
        <header class="bg-slate-800/90 border-2 border-slate-700 rounded-3xl p-4 sm:p-6 mb-4 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="bg-gradient-to-br from-cyan-500 to-blue-600 p-3 sm:p-4 rounded-2xl shadow-lg border-2 border-cyan-300/50">
                    <!-- Ledger Icon SVG -->
                    <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 7h6m-6 4h6m-6 4h6M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-purple-400">
                        N5 ACCOUNTING LEDGER LEGEND
                    </h1>
                    <p class="text-slate-400 text-sm sm:text-base font-medium">SQA National 5 Term Classifier • Touchscreen Classroom Edition</p>
                </div>
            </div>

            <!-- Header Utility Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-2.5 w-full md:w-auto">
                <!-- Cheat Sheet Modal Toggle Button -->
                <button id="btnOpenCheatSheet" title="Open Quick Reference Sheet" class="touch-btn bg-slate-700 hover:bg-slate-600 text-cyan-300 border-2 border-cyan-500/50 px-3.5 py-3 rounded-2xl font-bold text-sm sm:text-base transition flex items-center gap-2 shadow-lg min-h-[52px]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C20.832 18.477 19.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <span>Cheat Sheet</span>
                </button>

                <!-- DEDICATED GOOGLE SITES POP-OUT TAB BUTTON -->
                <button id="btnPopOutTab" title="Launch in Standalone Tab for SMART Boards & Google Sites" class="touch-btn bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white border-2 border-emerald-400 px-3.5 py-3 rounded-2xl font-extrabold text-sm sm:text-base transition flex items-center gap-2 shadow-xl min-h-[52px]">
                    <svg class="w-5 h-5 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    <span>Pop Out (New Tab)</span>
                </button>

                <!-- Audio Toggle Button -->
                <button id="btnToggleSound" class="touch-btn bg-slate-700 hover:bg-slate-600 text-slate-200 border-2 border-slate-600 px-3.5 py-3 rounded-2xl font-bold text-sm sm:text-base transition flex items-center gap-2 shadow-lg min-h-[52px]">
                    <span id="soundIconContainer">
                        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/>
                        </svg>
                    </span>
                    <span id="soundText" class="hidden sm:inline">Sound</span>
                </button>

                <!-- Fullscreen Toggle Button -->
                <button id="btnToggleFullscreen" class="touch-btn bg-blue-700 hover:bg-blue-600 text-white border-2 border-blue-400 px-4 py-3 rounded-2xl font-bold text-sm sm:text-base transition flex items-center gap-2 shadow-xl min-h-[52px]">
                    <span id="fullscreenIconContainer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                        </svg>
                    </span>
                    <span id="fullscreenText">Full Screen</span>
                </button>
            </div>
        </header>

        <!-- GOOGLE SITES IFRAME HELPER BANNER (Reminds users of Pop Out for SMART Boards) -->
        <div id="googleSitesBanner" class="bg-indigo-950/80 border-2 border-indigo-500/60 rounded-2xl p-3 mb-4 shadow-lg flex items-center justify-between text-xs sm:text-sm text-indigo-200">
            <div class="flex items-center gap-2">
                <span class="text-lg">💡</span>
                <span><strong>Using inside Google Sites or Canvas?</strong> Click <strong class="text-teal-300">"Pop Out (New Tab)"</strong> at top to launch full-screen monitor view for Interactive Whiteboards.</span>
            </div>
            <button onclick="document.getElementById('googleSitesBanner').remove()" class="touch-btn text-indigo-400 hover:text-white ml-2 font-bold p-1">✕</button>
        </div>

        <!-- GAME MODE SELECTOR BAR -->
        <div class="bg-slate-800/80 border-2 border-slate-700 rounded-2xl p-3 mb-4 shadow-xl flex flex-wrap items-center justify-center gap-3">
            <span class="text-slate-400 font-bold uppercase text-xs sm:text-sm tracking-wider px-2">Select Game Mode:</span>
            <button id="btnModePractice" class="touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-cyan-500 bg-cyan-600/30 text-cyan-300 transition shadow-md">
                🎓 Practice
            </button>
            <button id="btnModeTimed" class="touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-slate-600 bg-slate-700/50 text-slate-300 hover:border-amber-500 hover:text-amber-300 transition shadow-md">
                ⚡ Beat 60s
            </button>
            <button id="btnModeTeam" class="touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-slate-600 bg-slate-700/50 text-slate-300 hover:border-purple-500 hover:text-purple-300 transition shadow-md">
                ⚔️ Team Red vs Blue
            </button>
        </div>

        <!-- DASHBOARD & SCOREBOARD STATUS BAR -->
        <div id="dashboardBar" class="bg-slate-800/90 border-2 border-slate-700 rounded-2xl p-4 mb-4 shadow-lg flex flex-wrap items-center justify-between gap-4">
            
            <!-- Standard Mode Stats -->
            <div id="standardStats" class="flex items-center gap-6 w-full sm:w-auto justify-around">
                <div class="text-center sm:text-left">
                    <span class="text-slate-400 text-xs sm:text-sm font-semibold uppercase tracking-wider block">Score</span>
                    <span id="scoreVal" class="text-2xl sm:text-4xl font-black text-cyan-400">0</span>
                </div>
                <div class="h-8 w-0.5 bg-slate-700"></div>
                <div class="text-center sm:text-left">
                    <span class="text-slate-400 text-xs sm:text-sm font-semibold uppercase tracking-wider block">Streak</span>
                    <span id="streakVal" class="text-2xl sm:text-4xl font-black text-amber-400">0 🔥</span>
                </div>
                <div class="h-8 w-0.5 bg-slate-700"></div>
                <div class="text-center sm:text-left">
                    <span class="text-slate-400 text-xs sm:text-sm font-semibold uppercase tracking-wider block">Progress</span>
                    <span id="progressVal" class="text-2xl sm:text-4xl font-black text-purple-400">1/34</span>
                </div>
            </div>

            <!-- Timed Countdown Bar (Hidden by default) -->
            <div id="timedStats" class="hidden flex-1 w-full max-w-md mx-auto flex items-center gap-4">
                <span class="text-amber-400 font-extrabold text-xl sm:text-2xl whitespace-nowrap">⏳ Time Left:</span>
                <div class="flex-1 bg-slate-900 border-2 border-amber-500/50 h-7 rounded-full overflow-hidden p-0.5">
                    <div id="timerProgressBar" class="bg-gradient-to-r from-amber-500 to-rose-500 h-full rounded-full transition-all duration-300 w-full"></div>
                </div>
                <span id="timerText" class="text-2xl font-black text-amber-300 min-w-[45px]">60s</span>
            </div>

            <!-- Team Scoreboard (Hidden by default) -->
            <div id="teamStats" class="hidden w-full flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center justify-between w-full sm:w-auto gap-8">
                    <!-- Team Red -->
                    <div id="teamRedBox" class="bg-rose-950/80 border-4 border-rose-500 rounded-2xl px-6 py-2 text-center flex-1 sm:flex-none">
                        <span class="text-rose-300 text-xs font-bold uppercase tracking-widest block">TEAM RED</span>
                        <span id="teamRedScore" class="text-3xl sm:text-4xl font-black text-rose-400">0</span>
                    </div>

                    <div class="text-slate-500 font-black text-2xl">VS</div>

                    <!-- Team Blue -->
                    <div id="teamBlueBox" class="bg-blue-950/80 border-4 border-slate-700 rounded-2xl px-6 py-2 text-center flex-1 sm:flex-none">
                        <span class="text-blue-300 text-xs font-bold uppercase tracking-widest block">TEAM BLUE</span>
                        <span id="teamBlueScore" class="text-3xl sm:text-4xl font-black text-blue-400">0</span>
                    </div>
                </div>

                <!-- Active Turn Banner -->
                <div id="teamTurnBanner" class="bg-rose-600 text-white border-2 border-rose-300 px-6 py-3 rounded-2xl font-black text-lg sm:text-xl text-center shadow-lg w-full sm:w-auto">
                    🔥 TEAM RED'S TURN
                </div>
            </div>

        </div>

        <!-- MAIN GAMEPLAY AREA -->
        <main class="flex-1 flex flex-col justify-center gap-6 mb-12">

            <!-- ACTIVE TERM QUESTION CARD -->
            <div class="bg-slate-800/90 border-4 border-indigo-500 rounded-3xl p-6 sm:p-10 shadow-2xl glow-active flex flex-col items-center justify-center text-center relative overflow-hidden">
                <div class="absolute top-3 left-4 text-xs sm:text-sm font-bold uppercase tracking-widest text-slate-400 flex items-center gap-1.5">
                    <span id="stageBadge" class="bg-indigo-600 text-white px-3 py-1 rounded-lg">STAGE 1: CATEGORY</span>
                    <span class="text-slate-500">• SQA N5 Term</span>
                </div>

                <!-- HUGE TERM DISPLAY -->
                <div id="termTitle" class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-wide my-4 py-2 drop-shadow-md">
                    Loading Term...
                </div>

                <!-- Dynamic Subtitle Prompt -->
                <p id="termPrompt" class="text-indigo-300 text-base sm:text-xl font-bold">
                    Select the correct Statement of Financial Position or Income Statement category below:
                </p>

                <!-- Optional SQA Hint Box -->
                <div id="hintBox" class="hidden mt-4 bg-slate-900/90 border-2 border-amber-500/50 text-amber-300 p-4 rounded-2xl text-base sm:text-lg max-w-2xl text-left">
                    <span class="font-bold uppercase text-xs tracking-widest text-amber-400 block mb-1">💡 SQA Context Hint:</span>
                    <span id="hintText">Hint contents...</span>
                </div>

                <button id="btnToggleHint" class="touch-btn mt-3 text-amber-400 hover:text-amber-300 underline font-semibold text-sm sm:text-base">
                    💡 Show SQA Hint
                </button>
            </div>

            <!-- STAGE 1: 8 CATEGORY SELECTION BUTTONS -->
            <div id="stage1CategoryGrid" class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
                
                <!-- 1. Non-Current Assets -->
                <button data-cat="NCA" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-cyan-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-cyan-400 uppercase tracking-wider block mb-0.5">ASSET (LONG TERM)</span>
                    <span class="text-base sm:text-xl font-extrabold">Non-Current Assets</span>
                </button>

                <!-- 2. Current Assets -->
                <button data-cat="CA" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-teal-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-teal-400 uppercase tracking-wider block mb-0.5">ASSET (SHORT TERM)</span>
                    <span class="text-base sm:text-xl font-extrabold">Current Assets</span>
                </button>

                <!-- 3. Non-Current Liabilities -->
                <button data-cat="NCL" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-purple-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-purple-400 uppercase tracking-wider block mb-0.5">DEBT (LONG TERM)</span>
                    <span class="text-base sm:text-xl font-extrabold">Non-Current Liabilities</span>
                </button>

                <!-- 4. Current Liabilities -->
                <button data-cat="CL" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-rose-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-rose-400 uppercase tracking-wider block mb-0.5">DEBT (SHORT TERM)</span>
                    <span class="text-base sm:text-xl font-extrabold">Current Liabilities</span>
                </button>

                <!-- 5. Revenue / Income -->
                <button data-cat="REV" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-emerald-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-emerald-400 uppercase tracking-wider block mb-0.5">INCOME STATEMENT</span>
                    <span class="text-base sm:text-xl font-extrabold">Revenue / Income</span>
                </button>

                <!-- 6. Operating Expenses -->
                <button data-cat="EXP" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-amber-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-amber-400 uppercase tracking-wider block mb-0.5">INCOME STATEMENT</span>
                    <span class="text-base sm:text-xl font-extrabold">Operating Expenses</span>
                </button>

                <!-- 7. Cost of Sales & Purchases -->
                <button data-cat="COS" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-orange-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-orange-400 uppercase tracking-wider block mb-0.5">TRADING ACCOUNT</span>
                    <span class="text-base sm:text-xl font-extrabold">Purchases & Cost of Sales</span>
                </button>

                <!-- 8. Capital & Drawings -->
                <button data-cat="CAP" class="touch-btn cat-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border-4 border-indigo-500/70 rounded-2xl p-4 sm:p-5 text-center min-h-[95px] flex flex-col items-center justify-center shadow-xl transition active:scale-95">
                    <span class="text-xs sm:text-sm font-black text-indigo-400 uppercase tracking-wider block mb-0.5">EQUITY & OWNERSHIP</span>
                    <span class="text-base sm:text-xl font-extrabold">Capital & Drawings</span>
                </button>

            </div>

            <!-- STAGE 2: BALANCE SELECTION (DEBIT vs CREDIT) (Clean tiles, no prompt labels) -->
            <div id="stage2BalanceGrid" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- DEBIT CHOICE -->
                <button id="btnSelectDebit" class="touch-btn bg-slate-800 hover:bg-slate-700 text-blue-300 border-4 border-blue-500 rounded-3xl p-6 sm:p-10 min-h-[120px] flex items-center justify-center shadow-2xl transition active:scale-95">
                    <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-wide">DEBIT BALANCE [Dr]</span>
                </button>

                <!-- CREDIT CHOICE -->
                <button id="btnSelectCredit" class="touch-btn bg-slate-800 hover:bg-slate-700 text-emerald-300 border-4 border-emerald-500 rounded-3xl p-6 sm:p-10 min-h-[120px] flex items-center justify-center shadow-2xl transition active:scale-95">
                    <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-wide">CREDIT BALANCE [Cr]</span>
                </button>
            </div>

            <!-- POST-ANSWER FEEDBACK DISPLAY PANEL -->
            <div id="feedbackPanel" class="hidden bg-slate-800 border-4 rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col items-center text-center gap-4 mb-16">
                <!-- Correct / Incorrect Banner -->
                <div id="feedbackBanner" class="text-3xl sm:text-5xl font-black uppercase tracking-wider">
                    Correct!
                </div>

                <!-- DEAD CLIC Explanation -->
                <p id="feedbackExplanation" class="text-lg sm:text-2xl text-slate-200 font-medium max-w-3xl">
                    Explanation goes here...
                </p>

                <!-- SQA Exam Note -->
                <div id="feedbackExamNote" class="bg-indigo-950/80 border-2 border-indigo-400/50 p-4 rounded-2xl text-indigo-200 text-base sm:text-lg max-w-3xl text-left w-full">
                    <span class="font-black text-indigo-300 uppercase tracking-widest text-xs block mb-1">📌 SQA Exam Distinction Note:</span>
                    <span id="examNoteText">Note contents...</span>
                </div>

                <!-- Next Button -->
                <button id="btnNextTerm" class="touch-btn w-full max-w-md bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-2xl sm:text-3xl py-4 sm:py-5 px-8 rounded-2xl border-2 border-emerald-300 shadow-xl transition active:scale-95 min-h-[75px] mt-2">
                    NEXT TERM ➔
                </button>
            </div>

        </main>
    </div>

    <!-- CHEAT SHEET REFERENCE MODAL -->
    <div id="cheatSheetModal" class="hidden fixed inset-0 z-[99999] bg-slate-950/90 backdrop-blur-md p-4 sm:p-8 overflow-y-auto flex justify-center items-start">
        <div class="bg-slate-800 border-4 border-cyan-500 rounded-3xl p-6 sm:p-10 max-w-4xl w-full my-auto shadow-2xl text-slate-100 relative">
            
            <button id="btnCloseCheatSheet" class="touch-btn absolute top-4 right-4 bg-slate-700 hover:bg-slate-600 border-2 border-slate-500 text-white rounded-2xl w-12 h-12 flex items-center justify-center font-bold text-2xl">
                ✕
            </button>

            <h2 class="text-3xl sm:text-4xl font-black text-cyan-400 mb-4 flex items-center gap-3">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C20.832 18.477 19.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                SQA N5 Accounting Quick Reference
            </h2>

            <!-- DEAD CLIC GRID -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <!-- DEAD -->
                <div class="bg-blue-950/80 border-2 border-blue-500 p-5 rounded-2xl">
                    <h3 class="text-2xl font-black text-blue-400 mb-2">DEBIT BALANCES [Dr] = D.E.A.D</h3>
                    <ul class="space-y-2 text-base sm:text-lg font-semibold text-blue-100">
                        <li>• <strong class="text-blue-300">D</strong>rawings</li>
                        <li>• <strong class="text-blue-300">E</strong>xpenses (Operating Overhead Costs)</li>
                        <li>• <strong class="text-blue-300">A</strong>ssets (Non-Current & Current Assets)</li>
