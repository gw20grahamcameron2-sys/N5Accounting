            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function startNewGame(mode) {
            Sound.playClick();
            if (gameState.timerInterval) clearInterval(gameState.timerInterval);

            gameState.mode = mode;
            gameState.terms = shuffle(SQA_TERMS);
            gameState.currentIndex = 0;
            gameState.score = 0;
            gameState.streak = 0;
            gameState.totalAnswered = 0;
            gameState.correctCount = 0;
            gameState.teamRedScore = 0;
            gameState.teamBlueScore = 0;
            gameState.currentTeam = 'RED';

            // Update Mode Selector UI
            [DOM.btnModePractice, DOM.btnModeTimed, DOM.btnModeTeam].forEach(btn => {
                btn.className = "touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-slate-600 bg-slate-700/50 text-slate-300 transition shadow-md";
            });

            if (mode === 'practice') {
                DOM.btnModePractice.className = "touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-cyan-500 bg-cyan-600/30 text-cyan-300 transition shadow-md";
                DOM.standardStats.classList.remove('hidden');
                DOM.timedStats.classList.add('hidden');
                DOM.teamStats.classList.add('hidden');
            } else if (mode === 'timed') {
                DOM.btnModeTimed.className = "touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-amber-500 bg-amber-600/30 text-amber-300 transition shadow-md";
                DOM.standardStats.classList.remove('hidden');
                DOM.timedStats.classList.remove('hidden');
                DOM.teamStats.classList.add('hidden');
                startTimer();
            } else if (mode === 'team') {
                DOM.btnModeTeam.className = "touch-btn mode-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl font-extrabold text-base sm:text-lg border-2 border-purple-500 bg-purple-600/30 text-purple-300 transition shadow-md";
                DOM.standardStats.classList.add('hidden');
                DOM.timedStats.classList.add('hidden');
                DOM.teamStats.classList.remove('hidden');
                updateTeamUI();
            }

            DOM.gameOverModal.classList.add('hidden');
            loadCurrentTerm();
        }

        function startTimer() {
            gameState.timeLeft = 60;
            DOM.timerText.textContent = "60s";
            DOM.timerProgressBar.style.width = "100%";

            gameState.timerInterval = setInterval(() => {
                gameState.timeLeft--;
                DOM.timerText.textContent = gameState.timeLeft + "s";
                const pct = (gameState.timeLeft / 60) * 100;
                DOM.timerProgressBar.style.width = pct + "%";

                if (gameState.timeLeft <= 0) {
                    clearInterval(gameState.timerInterval);
                    endGame();
                }
            }, 1000);
        }

        function updateTeamUI() {
            DOM.teamRedScore.textContent = gameState.teamRedScore;
            DOM.teamBlueScore.textContent = gameState.teamBlueScore;

            if (gameState.currentTeam === 'RED') {
                DOM.teamTurnBanner.className = "bg-rose-600 text-white border-2 border-rose-300 px-6 py-3 rounded-2xl font-black text-lg sm:text-xl text-center shadow-lg w-full sm:w-auto animate-pulse";
                DOM.teamTurnBanner.textContent = "🔥 TEAM RED'S TURN";
                DOM.teamRedBox.className = "bg-rose-950/80 border-4 border-rose-500 rounded-2xl px-6 py-2 text-center flex-1 sm:flex-none glow-active";
                DOM.teamBlueBox.className = "bg-blue-950/80 border-4 border-slate-700 opacity-60 rounded-2xl px-6 py-2 text-center flex-1 sm:flex-none";
            } else {
                DOM.teamTurnBanner.className = "bg-blue-600 text-white border-2 border-blue-300 px-6 py-3 rounded-2xl font-black text-lg sm:text-xl text-center shadow-lg w-full sm:w-auto animate-pulse";
                DOM.teamTurnBanner.textContent = "⚡ TEAM BLUE'S TURN";
                DOM.teamBlueBox.className = "bg-blue-950/80 border-4 border-blue-500 rounded-2xl px-6 py-2 text-center flex-1 sm:flex-none glow-active";
                DOM.teamRedBox.className = "bg-rose-950/80 border-4 border-slate-700 opacity-60 rounded-2xl px-6 py-2 text-center flex-1 sm:flex-none";
            }
        }

        function loadCurrentTerm() {
            if (gameState.currentIndex >= gameState.terms.length) {
                gameState.terms = shuffle(SQA_TERMS);
                gameState.currentIndex = 0;
            }

            const term = gameState.terms[gameState.currentIndex];
            gameState.stage = 1;
            gameState.stage1Choice = null;

            // Update UI Elements
            DOM.termTitle.textContent = term.name;
            DOM.stageBadge.textContent = "STAGE 1: CATEGORY";
            DOM.stageBadge.className = "bg-indigo-600 text-white px-3 py-1 rounded-lg";
            DOM.termPrompt.textContent = "Select the correct Statement of Financial Position or Income Statement category below:";
            
            DOM.hintBox.classList.add('hidden');
            DOM.hintText.textContent = term.hint;
            DOM.btnToggleHint.textContent = "💡 Show SQA Hint";

            DOM.stage1CategoryGrid.classList.remove('hidden');
            DOM.stage2BalanceGrid.classList.add('hidden');
            DOM.feedbackPanel.classList.add('hidden');

            updateStatsDisplay();
        }

        function updateStatsDisplay() {
            DOM.scoreVal.textContent = gameState.score;
            DOM.streakVal.textContent = `${gameState.streak} 🔥`;
            DOM.progressVal.textContent = `${gameState.currentIndex + 1}/${gameState.terms.length}`;
        }

        function handleStage1Category(selectedCat) {
            Sound.playClick();
            const term = gameState.terms[gameState.currentIndex];
            gameState.stage1Choice = selectedCat;

            if (selectedCat === term.cat) {
                // Correct Category -> Move to Stage 2 Balance
                gameState.stage = 2;
                DOM.stage1CategoryGrid.classList.add('hidden');
                DOM.stage2BalanceGrid.classList.remove('hidden');

                DOM.stageBadge.textContent = "STAGE 2: LEDGER BALANCE";
                DOM.stageBadge.className = "bg-amber-500 text-slate-950 px-3 py-1 rounded-lg font-black";
                DOM.termPrompt.textContent = `Correct Category (${term.catName})! Now select the Ledger Balance type:`;
            } else {
                // Incorrect Category -> Show immediate feedback
                processFinalAnswer(false, `Wrong Category! ${term.name} belongs to ${term.catName}.`);
            }
        }

        function handleStage2Balance(selectedBalance) {
            const term = gameState.terms[gameState.currentIndex];
            const isCorrect = (selectedBalance === term.balance);
            
            let message = "";
            if (isCorrect) {
                message = `Spot on! ${term.name} is a ${term.catName} with a ${term.balance} balance.`;
            } else {
                message = `Incorrect Balance! ${term.name} (${term.catName}) has a ${term.balance} balance.`;
            }

            processFinalAnswer(isCorrect, message);
        }

        function processFinalAnswer(isCorrect, explanation) {
            gameState.totalAnswered++;
            const term = gameState.terms[gameState.currentIndex];

            DOM.stage1CategoryGrid.classList.add('hidden');
            DOM.stage2BalanceGrid.classList.add('hidden');
            DOM.feedbackPanel.classList.remove('hidden');

            if (isCorrect) {
                Sound.playCorrect();
                gameState.score += 10 + Math.min(gameState.streak * 2, 20);
                gameState.streak++;
                gameState.correctCount++;

                if (gameState.mode === 'team') {
                    if (gameState.currentTeam === 'RED') gameState.teamRedScore += 10;
                    else gameState.teamBlueScore += 10;
                }

                DOM.feedbackPanel.className = "bg-slate-800 border-4 border-emerald-500 rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col items-center text-center gap-4 mb-16";
                DOM.feedbackBanner.textContent = "✅ EXCELLENT! CORRECT!";
                DOM.feedbackBanner.className = "text-3xl sm:text-5xl font-black text-emerald-400 uppercase tracking-wider";

                if (gameState.streak % 5 === 0) Confetti.launch();
            } else {
                Sound.playIncorrect();
                gameState.streak = 0;
                DOM.feedbackPanel.className = "bg-slate-800 border-4 border-rose-500 rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col items-center text-center gap-4 mb-16";
                DOM.feedbackBanner.textContent = "❌ INCORRECT";
                DOM.feedbackBanner.className = "text-3xl sm:text-5xl font-black text-rose-400 uppercase tracking-wider";
            }

            // DEAD CLIC Explanation generator
            let deadClicRule = "";
            if (term.balance === "DEBIT") {
                deadClicRule = `According to DEAD CLIC: Debits include Expenses, Assets, Drawings, & Direct Costs (D.E.A.D).`;
            } else {
                deadClicRule = `According to DEAD CLIC: Credits include Capital, Liabilities, Income, & Credit Adjustments (C.L.I.C).`;
            }

            DOM.feedbackExplanation.innerHTML = `${explanation}<br><span class="text-base sm:text-xl text-cyan-300 font-bold mt-2 block">${deadClicRule}</span>`;
            DOM.examNoteText.textContent = term.examNote;

            updateStatsDisplay();
            if (gameState.mode === 'team') updateTeamUI();
        }

        function advanceNextTerm() {
            Sound.playClick();
            if (gameState.mode === 'team') {
                gameState.currentTeam = (gameState.currentTeam === 'RED') ? 'BLUE' : 'RED';
            }

            gameState.currentIndex++;
            if (gameState.currentIndex >= gameState.terms.length && gameState.mode === 'practice') {
                endGame();
            } else {
                loadCurrentTerm();
            }
        }

        function endGame() {
            if (gameState.timerInterval) clearInterval(gameState.timerInterval);
            Sound.playWin();
            Confetti.launch();

            const accuracy = gameState.totalAnswered > 0 
                ? Math.round((gameState.correctCount / gameState.totalAnswered) * 100) 
                : 100;

            DOM.finalScoreVal.textContent = gameState.score;
            DOM.finalAccuracyVal.textContent = accuracy + "%";

            let grade = "C Grade - Keep Practicing";
            if (accuracy >= 90 && gameState.score >= 100) grade = "🏆 S Class - N5 Ledger Master";
            else if (accuracy >= 75) grade = "🥇 A Grade - Ledger Legend";
            else if (accuracy >= 60) grade = "🥈 B Grade - Good Effort";

            DOM.gameOverGrade.textContent = grade;
            DOM.gameOverModal.classList.remove('hidden');
        }

        // --- 8. EVENT BINDINGS ---
        function bindEvents() {
            // Standalone Pop-Out Tab (Google Sites Solution)
            DOM.btnPopOutTab.addEventListener('click', launchStandaloneTab);

            // Fullscreen & Sound
            DOM.btnToggleFullscreen.addEventListener('click', toggleFullscreen);
            DOM.btnToggleSound.addEventListener('click', () => {
                Sound.playClick();
                gameState.soundEnabled = !gameState.soundEnabled;
                if (gameState.soundEnabled) {
                    DOM.soundText.textContent = "Sound";
                    DOM.soundIconContainer.innerHTML = `
                        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/>
                        </svg>`;
                } else {
                    DOM.soundText.textContent = "Mute";
                    DOM.soundIconContainer.innerHTML = `
                        <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" stroke-dasharray="2 2"/>
                        </svg>`;
                }
            });

            // Native fullscreen change listeners
            ['fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'MSFullscreenChange'].forEach(evt => {
                document.addEventListener(evt, () => {
                    const active = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
                    if (!active && !isSimulatedFullscreen) updateFullscreenUI(false);
                    else if (active) updateFullscreenUI(true);
                });
            });

            // ESC Key listener for simulated fullscreen
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && isSimulatedFullscreen) {
                    exitFullscreen();
                }
            });

            // Cheat Sheet Modal
            const openModal = () => { Sound.playClick(); DOM.cheatSheetModal.classList.remove('hidden'); };
            const closeModal = () => { Sound.playClick(); DOM.cheatSheetModal.classList.add('hidden'); };
            DOM.btnOpenCheatSheet.addEventListener('click', openModal);
            DOM.btnCloseCheatSheet.addEventListener('click', closeModal);
            DOM.btnCloseCheatSheetBottom.addEventListener('click', closeModal);

            // Mode Selector
            DOM.btnModePractice.addEventListener('click', () => startNewGame('practice'));
            DOM.btnModeTimed.addEventListener('click', () => startNewGame('timed'));
            DOM.btnModeTeam.addEventListener('click', () => startNewGame('team'));

            // SQA Hint Toggle
            DOM.btnToggleHint.addEventListener('click', () => {
                Sound.playClick();
                const hidden = DOM.hintBox.classList.contains('hidden');
                if (hidden) {
                    DOM.hintBox.classList.remove('hidden');
                    DOM.btnToggleHint.textContent = "🙈 Hide Hint";
                } else {
                    DOM.hintBox.classList.add('hidden');
                    DOM.btnToggleHint.textContent = "💡 Show SQA Hint";
                }
            });

            // Stage 1 Category Selection Buttons
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const cat = e.currentTarget.getAttribute('data-cat');
                    handleStage1Category(cat);
                });
            });

            // Stage 2 Balance Selection Buttons (Clean tiles without prompt subtext)
            DOM.btnSelectDebit.addEventListener('click', () => handleStage2Balance('DEBIT'));
            DOM.btnSelectCredit.addEventListener('click', () => handleStage2Balance('CREDIT'));

            // Next Term & Play Again
            DOM.btnNextTerm.addEventListener('click', advanceNextTerm);
            DOM.btnPlayAgain.addEventListener('click', () => startNewGame(gameState.mode));

            // Window resize for confetti
            window.addEventListener('resize', () => Confetti.resize());
        }

        // Initialize App on Window Load
        window.onload = function() {
            bindEvents();
            startNewGame('practice');
        };
    </script>
</body>
</html>
